<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>URUA EXPOSURE | Waste-to-Value Infrastructure</title>
    <meta name="description" content="URUA transforms waste into energy, financial value, and community-driven economic systems through advanced processing and blockchain infrastructure.">
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- AOS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-base: #0A0C0E;
            --bg-elevated: #111316;
            --bg-overlay: #1A1D23;
            --surface-primary: #0F2B1A;
            --surface-primary-light: #1A3D28;
            --surface-accent: #C5A059;
            --surface-accent-dark: #9E7E3E;
            --text-primary: #FFFFFF;
            --text-secondary: #A1A6AD;
            --text-accent: #E6C87D;
            --border-subtle: rgba(255,255,255,0.08);
            --border-active: rgba(197,160,89,0.5);
            --gradient-hero: linear-gradient(135deg, #0A0C0E 0%, #0F2B1A 100%);
            --gradient-card: linear-gradient(145deg, #111316 0%, #0D0F12 100%);
            --gradient-gold: linear-gradient(135deg, #C5A059 0%, #E6C87D 100%);
            --shadow-sm: 0 4px 20px rgba(0,0,0,0.3);
            --shadow-md: 0 8px 30px rgba(0,0,0,0.4);
            --shadow-lg: 0 20px 50px rgba(0,0,0,0.5);
            --shadow-glow: 0 0 20px rgba(197,160,89,0.3);
            --shadow-glow-green: 0 0 20px rgba(15,43,26,0.5);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-primary);
            line-height: 1.5;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-elevated);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--surface-accent);
            border-radius: 4px;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Navigation */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(10, 12, 14, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-subtle);
            z-index: 1000;
            padding: 16px 0;
            transition: all 0.3s ease;
        }
        .navbar.scrolled {
            padding: 12px 0;
            background: rgba(10, 12, 14, 0.98);
        }
        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-family: 'Syne', sans-serif;
            font-size: 28px;
            font-weight: 800;
            background: var(--gradient-gold);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-decoration: none;
        }
        .nav-links {
            display: flex;
            gap: 32px;
            align-items: center;
        }
        .nav-links a {
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }
        .nav-links a:hover {
            color: var(--surface-accent);
        }
        .btn-primary {
            background: var(--surface-accent);
            color: var(--bg-base);
            padding: 12px 28px;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-primary:hover {
            background: var(--surface-accent-dark);
            transform: translateY(-2px);
            box-shadow: var(--shadow-glow);
        }
        .btn-outline {
            border: 2px solid var(--surface-accent);
            background: transparent;
            color: var(--surface-accent);
            padding: 12px 28px;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-outline:hover {
            background: var(--surface-accent);
            color: var(--bg-base);
            transform: translateY(-2px);
        }
        .btn-large {
            padding: 16px 36px;
            font-size: 18px;
        }
        .mobile-menu-btn {
            display: none;
            font-size: 28px;
            cursor: pointer;
        }

        /* Hero */
        .hero {
            min-height: 100vh;
            background: var(--gradient-hero);
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            padding-top: 80px;
        }
        .particle-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.1;
        }
        .hero-content {
            position: relative;
            z-index: 2;
        }
        .badge {
            display: inline-block;
            background: rgba(197,160,89,0.15);
            border: 1px solid var(--border-active);
            padding: 8px 20px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-accent);
            margin-bottom: 24px;
            backdrop-filter: blur(5px);
        }
        .hero h1 {
            font-size: clamp(48px, 8vw, 90px);
            line-height: 1.1;
            margin-bottom: 24px;
        }
        .gradient-text {
            background: var(--gradient-gold);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .hero-subheadline {
            font-size: 18px;
            color: var(--text-secondary);
            max-width: 680px;
            margin-bottom: 40px;
            line-height: 1.6;
        }
        .hero-stats {
            display: flex;
            gap: 48px;
            margin-top: 60px;
            flex-wrap: wrap;
        }
        .stat-item h3 {
            font-size: 36px;
            color: var(--surface-accent);
        }
        .stat-item p {
            color: var(--text-secondary);
            font-size: 14px;
        }

        section {
            padding: 100px 0;
        }
        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }
        .section-header h2 {
            font-size: clamp(32px, 5vw, 56px);
            margin-bottom: 16px;
        }
        .section-header p {
            color: var(--text-secondary);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Cards */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
        }
        .card {
            background: var(--gradient-card);
            border: 1px solid var(--border-subtle);
            border-radius: 24px;
            padding: 32px;
            transition: all 0.3s;
            backdrop-filter: blur(10px);
        }
        .card:hover {
            transform: translateY(-8px);
            border-color: var(--border-active);
            box-shadow: var(--shadow-lg);
        }
        .card-icon {
            font-size: 48px;
            color: var(--surface-accent);
            margin-bottom: 24px;
        }
        .card h3 {
            font-size: 24px;
            margin-bottom: 12px;
        }
        .card p {
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Blockchain Dashboard */
        .dashboard-container {
            background: var(--bg-overlay);
            border-radius: 24px;
            padding: 32px;
            border: 1px solid var(--border-active);
            box-shadow: var(--shadow-lg);
        }
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 16px;
        }
        .dashboard-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .live-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(197,160,89,0.15);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
        }
        .live-dot {
            width: 8px;
            height: 8px;
            background: #00ff00;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.2); }
        }
        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
            margin-bottom: 32px;
        }
        .dashboard-stat {
            background: var(--bg-elevated);
            padding: 20px;
            border-radius: 16px;
            text-align: center;
        }
        .dashboard-stat-label {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }
        .dashboard-stat-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--surface-accent);
            font-family: 'Syne', monospace;
        }
        .transaction-list {
            max-height: 300px;
            overflow-y: auto;
        }
        .transaction {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-bottom: 1px solid var(--border-subtle);
        }
        .transaction:hover {
            background: var(--bg-elevated);
        }
        .transaction-hash {
            font-family: monospace;
            font-size: 12px;
            color: var(--text-accent);
        }
        .transaction-amount {
            font-weight: 600;
            color: var(--surface-accent);
        }

        /* Interactive Map */
        .map-container {
            background: var(--bg-overlay);
            border-radius: 24px;
            padding: 32px;
            border: 1px solid var(--border-active);
            position: relative;
        }
        .map-svg {
            width: 100%;
            height: auto;
            background: var(--bg-elevated);
            border-radius: 16px;
        }
        .hub-marker {
            cursor: pointer;
            transition: transform 0.3s;
        }
        .hub-marker:hover {
            transform: scale(1.2);
        }
        .hub-tooltip {
            position: fixed;
            background: var(--bg-overlay);
            border: 1px solid var(--border-active);
            border-radius: 12px;
            padding: 16px;
            z-index: 1000;
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow-lg);
            max-width: 250px;
            pointer-events: none;
            animation: fadeIn 0.2s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Modal for Investor Deck */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.9);
            backdrop-filter: blur(15px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }
        .modal.active {
            display: flex;
        }
        .modal-content {
            background: var(--gradient-card);
            border: 1px solid var(--border-active);
            border-radius: 32px;
            padding: 48px;
            max-width: 500px;
            width: 90%;
            position: relative;
            animation: slideUp 0.3s ease-out;
        }
        @keyframes slideUp {
            from { transform: translateY(50px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .modal-close {
            position: absolute;
            top: 20px;
            right: 24px;
            font-size: 28px;
            cursor: pointer;
            color: var(--text-secondary);
        }
        .form-group {
            margin-bottom: 24px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        .form-group input, .form-group select {
            width: 100%;
            padding: 14px 16px;
            background: var(--bg-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 16px;
            transition: all 0.3s;
        }
        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: var(--surface-accent);
            box-shadow: var(--shadow-glow);
        }

        /* Process Flow */
        .process-flow {
            background: var(--bg-elevated);
            border-radius: 32px;
            padding: 60px;
            margin-top: 40px;
        }
        .flow-steps {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            position: relative;
        }
        .flow-step {
            flex: 1;
            text-align: center;
            position: relative;
        }
        .flow-step::after {
            content: '→';
            position: absolute;
            right: -30px;
            top: 40px;
            font-size: 30px;
            color: var(--surface-accent);
            opacity: 0.5;
        }
        .flow-step:last-child::after {
            display: none;
        }
        .step-number {
            width: 60px;
            height: 60px;
            background: var(--surface-primary);
            border: 2px solid var(--surface-accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: bold;
            margin: 0 auto 20px;
        }
        .step-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .step-desc {
            color: var(--text-secondary);
            font-size: 14px;
        }

        /* Metrics */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 32px;
            text-align: center;
        }
        .metric-card {
            background: var(--gradient-card);
            border: 1px solid var(--border-subtle);
            border-radius: 24px;
            padding: 48px 32px;
        }
        .metric-number {
            font-size: 48px;
            font-weight: 800;
            color: var(--surface-accent);
            font-family: 'Syne', sans-serif;
        }

        /* Split Layout */
        .split-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }
        .split-content h3 {
            font-size: 36px;
            margin-bottom: 24px;
        }
        .feature-list {
            list-style: none;
            margin-top: 24px;
        }
        .feature-list li {
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .feature-list i {
            color: var(--surface-accent);
            font-size: 20px;
        }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, var(--surface-primary) 0%, var(--bg-base) 100%);
            text-align: center;
            border-radius: 32px;
            margin: 0 24px;
            padding: 80px 40px;
        }
        .cta-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 40px;
        }

        /* Footer */
        .footer {
            background: var(--bg-elevated);
            padding: 60px 0 30px;
            border-top: 1px solid var(--border-subtle);
            margin-top: 60px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }
        .social-links {
            display: flex;
            gap: 20px;
            margin-top: 16px;
        }
        .social-links a {
            color: var(--text-primary);
            font-size: 20px;
        }
        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            font-size: 14px;
        }

        /* Sticky CTA */
        .sticky-cta {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 999;
            display: none;
        }
        .sticky-cta.visible {
            display: block;
        }
        .sticky-btn {
            background: var(--surface-accent);
            color: var(--bg-base);
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: var(--shadow-lg);
            cursor: pointer;
            transition: all 0.3s;
        }
        .sticky-btn:hover {
            transform: scale(1.1);
        }

        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: block;
            }
            .nav-links {
                display: none;
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                background: var(--bg-base);
                flex-direction: column;
                padding: 20px;
                border-bottom: 1px solid var(--border-subtle);
            }
            .nav-links.active {
                display: flex;
            }
            .split-layout {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            .process-flow {
                padding: 30px;
            }
            .flow-step::after {
                display: none;
            }
            .cta-section {
                margin: 0 16px;
                padding: 50px 20px;
            }
            section {
                padding: 60px 0;
            }
            .dashboard-stats {
                grid-template-columns: 1fr;
            }
        }

        .toast {
            position: fixed;
            bottom: 100px;
            right: 24px;
            background: var(--surface-primary-light);
            border: 1px solid var(--surface-accent);
            border-radius: 12px;
            padding: 12px 24px;
            z-index: 2000;
            animation: slideInRight 0.3s ease-out;
        }
        @keyframes slideInRight {
            from { transform: translateX(100px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>
</head>
<body>

<!-- Navigation -->
<nav class="navbar" id="navbar">
    <div class="nav-container">
        <a href="#" class="logo">URUA<span style="color: var(--surface-accent);">∞</span></a>
        <div class="mobile-menu-btn" onclick="toggleMenu()">
            <i class="fas fa-bars"></i>
        </div>
        <div class="nav-links" id="navLinks">
            <a href="#home">Home</a>
