<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 800, once: true, offset: 100 });

    // Navbar scroll
    window.addEventListener('scroll', function() {
        const navbar = document.getElementById('navbar');
        const stickyCta = document.getElementById('stickyCta');
        if (window.scrollY > 100) {
            navbar.classList.add('scrolled');
            stickyCta.classList.add('visible');
        } else {
            navbar.classList.remove('scrolled');
            stickyCta.classList.remove('visible');
        }
    });

    // Counter animation
    const counters = document.querySelectorAll('.counter');
    const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const counter = entry.target;
                const target = parseInt(counter.getAttribute('data-target'));
                let current = 0;
                const increment = target / 80;
                const updateCounter = () => {
                    current += increment;
                    if (current < target) {
                        counter.innerText = Math.floor(current).toLocaleString();
                        setTimeout(updateCounter, 20);
                    } else {
                        counter.innerText = target.toLocaleString();
                    }
                };
                updateCounter();
                counterObserver.unobserve(counter);
            }
        });
    }, { threshold: 0.5 });
    counters.forEach(counter => counterObserver.observe(counter));

    // Blockchain Dashboard - Real-time data simulation
    function updateDashboard() {
        const tvl = 12450000 + Math.floor(Math.random() * 50000);
        const wallets = 8342 + Math.floor(Math.random() * 20);
        const price = (2.45 + (Math.random() - 0.5) * 0.05).toFixed(2);
        const volume = 1280000 + Math.floor(Math.random() * 50000);
        
        document.getElementById('tvlValue').innerText = tvl.toLocaleString();
        document.getElementById('walletCount').innerText = wallets.toLocaleString();
        document.getElementById('tokenPrice').innerText = price;
        document.getElementById('dailyVolume').innerText = volume.toLocaleString();
        
        // Add random transactions
        const transactions = [
            { hash: '0x' + Math.random().toString(36).substring(2, 10), amount: (Math.random() * 1000).toFixed(2), type: 'reward' },
            { hash: '0x' + Math.random().toString(36).substring(2, 10), amount: (Math.random() * 5000).toFixed(2), type: 'stake' },
            { hash: '0x' + Math.random().toString(36).substring(2, 10), amount: (Math.random() * 200).toFixed(2), type: 'transfer' }
        ];
        
        const txnList = document.getElementById('transactionList');
        if (txnList) {
            const newTxns = transactions.map(t => `
                <div class="transaction">
                    <span class="transaction-hash">${t.hash}</span>
                    <span><i class="fas fa-arrow-${t.type === 'reward' ? 'down' : 'right'}" style="color: var(--surface-accent);"></i></span>
                    <span class="transaction-amount">R${parseInt(t.amount).toLocaleString()}</span>
                </div>
            `).join('');
            
            const existing = txnList.innerHTML;
            txnList.innerHTML = newTxns + (existing.length > 800 ? existing.substring(0, 600) : existing);
            if (txnList.children.length > 15) {
                while(txnList.children.length > 15) txnList.removeChild(txnList.lastChild);
            }
        }
    }
    
    updateDashboard();
    setInterval(updateDashboard, 8000);
    
    // Populate initial transactions
    for(let i = 0; i < 5; i++) updateDashboard();

    // Interactive Map Tooltips
    const markers = document.querySelectorAll('.hub-marker');
    let tooltip = null;
    
    markers.forEach(marker => {
        marker.addEventListener('mouseenter', (e) => {
            const name = marker.getAttribute('data-name');
            const status = marker.getAttribute('data-status');
            const capacity = marker.getAttribute('data-capacity');
            const earnings = marker.getAttribute('data-earnings');
            
            if (tooltip) tooltip.remove();
            tooltip = document.createElement('div');
            tooltip.className = 'hub-tooltip';
            tooltip.innerHTML = `
                <strong style="color: var(--surface-accent);">${name}</strong><br>
                <span style="font-size: 12px;">Status: ${status}</span><br>
                <span style="font-size: 12px;">Capacity: ${capacity} tons/day</span><br>
                <span style="font-size: 12px;">Community earnings: ${earnings}</span>
            `;
            document.body.appendChild(tooltip);
            
            const updatePosition = (event) => {
                tooltip.style.left = (event.clientX + 15) + 'px';
                tooltip.style.top = (event.clientY - 50) + 'px';
            };
            
            marker.addEventListener('mousemove', updatePosition);
            marker.addEventListener('mouseleave', () => {
                tooltip.remove();
                marker.removeEventListener('mousemove', updatePosition);
            }, { once: true });
        });
    });

    // Particle background
    const canvas = document.getElementById('particleCanvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        
        const particles = [];
        for (let i = 0; i < 50; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                radius: Math.random() * 2,
                speedX: (Math.random() - 0.5) * 0.5,
                speedY: (Math.random() - 0.5) * 0.3
            });
        }
        
        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = 'rgba(197, 160, 89, 0.3)';
            particles.forEach(p => {
                p.x += p.speedX;
                p.y += p.speedY;
                if (p.x < 0) p.x = canvas.width;
                if (p.x > canvas.width) p.x = 0;
                if (p.y < 0) p.y = canvas.height;
                if (p.y > canvas.height) p.y = 0;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
            });
            requestAnimationFrame(animateParticles);
        }
        animateParticles();
        
        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });
    }

    // Modal functions
    function openInvestorModal() {
        document.getElementById('investorModal').classList.add('active');
    }
    
    function closeInvestorModal() {
        document.getElementById('investorModal').classList.remove('active');
    }
    
    // Form submission
    document.getElementById('investorForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const name = document.getElementById('investorName').value;
        const email = document.getElementById('investorEmail').value;
        
        // Show success message
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = `<i class="fas fa-check-circle" style="color: var(--surface-accent);"></i> Thanks ${name}! Check ${email} for your investor pack.`;
        document.body.appendChild(toast);
        
        setTimeout(() => toast.remove(), 4000);
        closeInvestorModal();
        this.reset();
        
        // In production: send to CRM/webhook
        console.log('Investor request:', { name, email, org: document.getElementById('investorOrg').value, range: document.getElementById('investorRange').value });
    });

    function toggleMenu() {
        document.getElementById('navLinks').classList.toggle('active');
    }

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
                if (window.innerWidth < 768) document.getElementById('navLinks')?.classList.remove('active');
            }
        });
    });
</script>
