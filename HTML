                <p>Empowering rural and township economies through decentralized processing centers.</p>
            </div>
            <div class="card" data-aos="fade-up" data-aos-delay="400">
                <div class="card-icon"><i class="fas fa-link"></i></div>
                <h3>Blockchain Incentives</h3>
                <p>ICBRC smart incentive system rewarding sustainable waste management practices.</p>
            </div>
        </div>
    </div>
</section>

<!-- BLOCKCHAIN DASHBOARD -->
<section id="blockchain" style="background: var(--bg-elevated);">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <h2>ICBRC Blockchain Dashboard</h2>
            <p>Real-time transparency • Smart incentives • Tokenized value</p>
